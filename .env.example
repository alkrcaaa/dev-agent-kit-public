# Qwen vLLM server address (required for Qwen MCP)
# Copy this file to .env:
#   cp .env.example .env
#
# Your local vLLM server address. Leave empty to skip Qwen-dependent parts.
# The URL must include /v1 (the OpenAI-compatible API path).
QWEN_BASE_URL=

# Spare endpoints (comma-separated) — listed in qwen's /model menu next to
# the default above; re-run install.sh after changing either.
QWEN_EXTRA_BASE_URLS=

# Memory MCP server — SQLite, no config needed. DB: ~/.claude/memory.db
# Override path if desired:
# MEMORY_DB_PATH=/custom/path/memory.db

# GitLab MCP (docs.gitlab.com/user/model_context_protocol) — HTTP transport,
# OAuth on first use via `/mcp` in Claude Code, no token to store.
# Off by default: the instance must expose /api/v4/mcp (GitLab 18.x+), or every
# session start waits on a dead endpoint.
# GITLAB_URL=https://gitlab.example.com

# Qwen Code has no interactive OAuth flow, so it needs a Personal Access Token
# (GitLab → Preferences → Access tokens, scope: api) to reach the same server.
# Leave unset and GitLab is simply skipped on the qwen side — Claude is
# unaffected either way and keeps using OAuth.
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# vault-search MCP — OFF by default (unset = the server is not registered).
# Point this at the ROOT of your Obsidian vault (or any folder of markdown
# notes). Separate from MEM_OBSIDIAN_VAULT below — one is the vault you read
# from, the other is where mem-lite writes to.
# VAULT_DIR=/path/to/your/vault

# Obsidian mirror for mem-lite saves — OFF by default (unset = no-op).
# When set, every mem_save is additionally appended as a raw markdown entry
# under $MEM_OBSIDIAN_VAULT/<project>/<YYYY-MM-DD>.md (one growing file per
# project per day). mem-lite's SQLite DB stays the source of truth; this is
# just a plain-text export for anyone who keeps notes in Obsidian or a plain
# folder of markdown files. What you do with the raw log afterwards (compile
# into curated notes, link it into a wiki, ignore it) is entirely up to your
# own vault workflow. Typically a subfolder of VAULT_DIR (e.g. VAULT_DIR's
# `_mem-log/`) so vault-search and the mirror log share one vault root.
# MEM_OBSIDIAN_VAULT=/path/to/your/vault/_mem-log

# Nightly vault-compile timer (on whenever VAULT_DIR is set). If the vault is
# git-synced across machines, let one machine compile and set this to 0 on
# the others; install.sh then turns the timer off there instead of on.
# VAULT_COMPILE_TIMER=0

# LSP MCP (pyright/clangd symbol navigation) — OFF by default.
# A full-history usage audit found 1 lsp_* call across ~35k API calls: the
# code-review-graph answers the same navigation questions and is what the
# gate steers to. Enabling pulls in clangd, pyright, lsp-mcp-server,
# supergateway, a systemd unit and an HTTP daemon, and adds a global MCP
# whose tool schemas load in every session. Set to 1 if you want it back.
ENABLE_LSP=0
