{
  "mcpServers": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-autobuild.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-gate.py\" remind"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-size-nudge.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/skill-nudge.py\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__mem-lite__mem_save",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/mem-save-guard.py\"; [ -f \"$H\" ] || exit 0; python3 \"$H\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-gate.py\" gate read"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-gate.py\" gate grep"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-gate.py\" gate bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bash-edit-guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/skill-gate.py\" gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/commit-attribution-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/skill-nudge.py\" bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__code-review-graph__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-gate.py\" mark"
          }
        ]
      },
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/skill-gate.py\" mark"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/snapshot-size-nudge.py\""
          }
        ]
      },
      {
        "matcher": "mcp__mem-lite__mem_save",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/obsidian-mirror.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/crg-update.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/lint-on-edit.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/hooks/consistency-check.py\"; [ -f \"$H\" ] && python3 \"$H\" --oneline || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/vault-inject.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/dispatch-inject.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/personal-capture.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/concept-capture.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/project-narrative.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/obsidian-mirror.py\"; [ -f \"$H\" ] && python3 \"$H\" --reconcile || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/project-narrative.py\"; [ -f \"$H\" ] && python3 \"$H\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/.claude/extern/obsidian-vault-bridge/hooks/obsidian-mirror.py\"; [ -f \"$H\" ] && python3 \"$H\" --reconcile || true"
          }
        ]
      }
    ]
  }
}
